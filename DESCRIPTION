Package: discoverHTE
Title: Discover Heterogeneous Effects of Continuous Exposures
Version: 0.1.0
Authors@R: c(
    person("Falco J.", "Bargagli-Stoffi",
           email = "falco@ucla.edu", role = c("aut", "cph"),
           comment = c(ORCID = "0000-0002-6131-8165")),
    person("Noah", "Greifer",
           email = "ngreifer@iq.harvard.edu", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0003-3067-7154")),
